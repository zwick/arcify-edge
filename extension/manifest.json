{
  "manifest_version": 3,
  "name": "Arcify Edge",
  "version": "1.0.0",
  "description": "Arc-style shortcuts for Edge: copy page and tab URLs, switch recent tabs, and split views.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "offscreen",
    "scripting",
    "contextMenus",
    "tabs",
    "favicon",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "split-drag.js",
        "mru-switcher.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "copy-page-url": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy the active page URL"
    },
    "mru-next": {
      "suggested_key": {
        "default": "Ctrl+E",
        "mac": "Command+E"
      },
      "description": "Switch to the next most recently used tab"
    },
    "mru-previous": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Switch to the previous most recently used tab"
    },
    "split-selected-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Split the two selected tabs, or unsplit the current split"
    }
  }
}
