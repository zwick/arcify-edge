{
  "manifest_version": 3,
  "name": "Arcify Edge",
  "version": "1.0.0",
  "description": "Copy the active page URL with Command+Shift+C.",
  "permissions": ["activeTab", "clipboardWrite", "offscreen", "scripting", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["split-drag.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "copy-page-url": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy the active page URL"
    }
  }
}
